        "-NoProfile",
        "-Command",
        "& \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin\\cmake.exe\" --build native/windows_aec_helper/build --config Release"
