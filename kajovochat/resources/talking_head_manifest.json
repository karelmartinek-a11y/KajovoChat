      "head_tx_scale": 0.052,
      "head_ty_scale": 0.053,
      "head_rot_deg": 5.9,
      "speech_scale_boost": 0.008
    },
    "thinking": {
      "head_scale": 1.004,
      "overlay_strength": 0.52,
      "head_tx_scale": 0.051,
      "head_ty_scale": 0.052,
      "head_rot_deg": 6.0,
      "speech_scale_boost": 0.008
    },
    "speaking": {
      "head_scale": 1.01,
      "overlay_strength": 0.64,
      "head_tx_scale": 0.054,
      "head_ty_scale": 0.055,
      "head_rot_deg": 6.2,
      "speech_scale_boost": 0.01
    },
    "error": {
