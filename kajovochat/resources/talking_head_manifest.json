      "fallback_head",
      "fallback_face_shadow",
      "fallback_cheek_polish"
    ],
    "production": [
      "prod_head_base",
      "prod_eye_layer",
      "prod_mouth_upper",
      "prod_mouth_lower"
    ],
    "overlay": [
      "mouth_interior",
      "blink_overlay",
      "state_overlay"
